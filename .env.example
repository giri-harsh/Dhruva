# Copy to .env (git-ignored) and fill in locally. NEVER commit real values.
# The model-signing PRIVATE key never lives here or on any dev machine — it is a
# CI secret only (v3 PRD §15.3 / FR-25). Do not add it.

# --- backend (FastAPI) ---
ANCHOR_DB_URL=postgresql+psycopg://anchor:anchor@localhost:5432/anchor
ANCHOR_MODEL_REGISTRY_DIR=./backend/_registry_store
ANCHOR_MAP_EXTRACT_DIR=./maps/_build
ANCHOR_ENV=dev

# --- model signing (PUBLIC key path only; private key is CI-only) ---
ANCHOR_SIGNING_PUBLIC_KEY_PATH=./ml/export/keys/anchor_pub.pem

# --- dataset ---
IOVNBD_ROOT=./data/raw/IO-VNBD
