# Large training artifacts that are NOT the committed contract stub —
# real trained weights and checkpoints live outside git, published
# through the backend's model registry (GET /v1/model/version), not
# committed to the repo. Only the small stub in contracts/model_io/
# is ever committed as an .onnx file.
*.ckpt
*.pt
checkpoints/
runs/
wandb/

# Big raw datasets — IO-VNBD extracted CSVs, OSM .osm.pbf extracts
data/raw/
*.osm.pbf

# Secrets / local config
.env
ml/export/keys/
backend/_registry_store/
maps/_build/

# OS noise
.DS_Store
Thumbs.db

# bench results are regenerable + timestamped — curated snapshots committed explicitly
ml/bench/results/

ml/.cache/
ml/train/runs/

backend/_flywheel/

ml/.cache/features_unsync/
ml/train/pretrain/
